{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "padding": {"bottom": 45},
  "data": {
    "url": "data/gross_value.csv",
    "format": {"type": "csv"}
  },
  "params": [
    {
      "name": "startYear",
      "value": 1979,
      "bind": {
        "input": "range",
        "min": 1979,
        "max": 2020,
        "step": 1,
        "name": "Show from year: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.Value != null && datum.Value != ''"},
    {"calculate": "toNumber(datum.Value)", "as": "Value_num"},
    {"calculate": "toNumber(substring(datum.Year, 0, 4))", "as": "year_num"},
    {"filter": "datum.year_num >= startYear"},
    {
      "calculate": "datum.Commodity == 'Fruit and nuts (excluding grapes)' ? 'Fruit & nuts' : datum.Commodity == 'Nursery, cut flowers and turf' ? 'Nursery' : datum.Commodity",
      "as": "Commodity_short"
    }
  ],
  "mark": {
    "type": "line",
    "point": false
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelOverlap": "parity",
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "Value_num",
      "type": "quantitative",
      "title": "Farm gate value ($ million)"
    },
    "color": {
      "field": "Commodity_short",
      "type": "nominal",
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": null,
        "columns": 3,
        "labelFontSize": 11,
        "labelLimit": 220,
        "symbolType": "stroke",
        "symbolStrokeWidth": 3
      }
    },
    "tooltip": [
      {"field": "Commodity", "type": "nominal"},
      {"field": "Year", "type": "ordinal"},
      {"field": "Value_num", "type": "quantitative", "title": "Value", "format": ","}
    ]
  }
}
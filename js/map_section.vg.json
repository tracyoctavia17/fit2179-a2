{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Farm Gate Value by State (2023–24)",
  "hconcat": [
    {
      "width": 450,
      "height": 350,
      "projection": { "type": "mercator" },
      "layer": [
        {
          "data": {
            "url": "js/au-states-topo.json",
            "format": { "type": "topojson", "feature": "austates" }
          },
          "mark": { "type": "geoshape", "fill": "#e8e8e8", "stroke": "white", "strokeWidth": 1 }
        },
        {
          "data": {
            "url": "js/au-states-topo.json",
            "format": { "type": "topojson", "feature": "austates" }
          },
          "transform": [
            {
              "lookup": "id",
              "from": {
                "data": {
                  "values": [
                    { "id": 0, "state": "New South Wales",              "total_value": 3483.2,  "rank": 3 },
                    { "id": 1, "state": "Victoria",                     "total_value": 4989.8,  "rank": 1 },
                    { "id": 2, "state": "Queensland",                   "total_value": 4441.8,  "rank": 2 },
                    { "id": 3, "state": "South Australia",           "total_value": 2260.50, "rank": 4 },
                    { "id": 4, "state": "Western Australia",            "total_value": 1390.3,  "rank": 5 },
                    { "id": 5, "state": "Tasmania",                     "total_value": 1024.6,  "rank": 6 },
                    { "id": 6, "state": "Northern Territory",           "total_value": 221.8,   "rank": 7 },
                    { "id": 7, "state": "Australian Capital Territory", "total_value": 0.2,     "rank": 8 }
                  ]
                },
                "key": "id",
                "fields": ["state", "total_value", "rank"]
              }
            }
          ],
          "params": [
            {
              "name": "state_select",
              "select": { "type": "point", "fields": ["state"] },
              "value": [{ "state": "Victoria" }]
            }
          ],
          "mark": { "type": "geoshape", "stroke": "white", "strokeWidth": 1.2 },
          "encoding": {
            "color": {
              "field": "total_value",
              "type": "quantitative",
              "scale": { "scheme": "greens", "domain": [0, 7000] },
              "legend": {
                "title": "Farm gate value ($m)",
                "orient": "bottom-left",
                "gradientLength": 150
              }
            },
            "opacity": {
              "condition": { "param": "state_select", "value": 1 },
              "value": 0.4
            },
            "tooltip": [
              { "field": "state",       "title": "State" },
              { "field": "total_value", "title": "Farm gate value ($m)", "format": "," },
              { "field": "rank",        "title": "National rank" }
            ]
          }
        }
      ]
    },
    {
      "title": "Crop Breakdown — click a state on the map",
      "width": 280,
      "height": 350,
      "data": {
        "values": [
          { "state": "Victoria",          "category": "Fruit",       "value": 1813.0 },
          { "state": "Victoria",          "category": "Vegetables",  "value": 1669.1 },
          { "state": "Victoria",          "category": "Nursery",     "value": 908.7  },
          { "state": "Victoria",          "category": "Nuts",        "value": 420.8  },
          { "state": "Victoria",          "category": "Wine grapes", "value": 178.2  },
          { "state": "Queensland",        "category": "Fruit",       "value": 2024.1 },
          { "state": "Queensland",        "category": "Nursery",     "value": 963.9  },
          { "state": "Queensland",        "category": "Vegetables",  "value": 1312.5 },
          { "state": "Queensland",        "category": "Nuts",        "value": 139.9  },
          { "state": "Queensland",        "category": "Wine grapes", "value": 1.4    },
          { "state": "New South Wales",   "category": "Fruit",       "value": 1445.7 },
          { "state": "New South Wales",   "category": "Nursery",     "value": 920.2  },
          { "state": "New South Wales",   "category": "Vegetables",  "value": 595.5  },
          { "state": "New South Wales",   "category": "Nuts",        "value": 347.8  },
          { "state": "New South Wales",   "category": "Wine grapes", "value": 174.0  },
          { "state": "South Australia",   "category": "Wine grapes", "value": 518.3  },
          { "state": "South Australia",   "category": "Vegetables",  "value": 934.8  },
          { "state": "South Australia",   "category": "Fruit",       "value": 433.1  },
          { "state": "South Australia",   "category": "Nuts",        "value": 272.2  },
          { "state": "South Australia",   "category": "Nursery",     "value": 102.1  },
          { "state": "Western Australia", "category": "Fruit",       "value": 600.4  },
          { "state": "Western Australia", "category": "Vegetables",  "value": 424.3  },
          { "state": "Western Australia", "category": "Nursery",     "value": 286.0  },
          { "state": "Western Australia", "category": "Wine grapes", "value": 72.3   },
          { "state": "Western Australia", "category": "Nuts",        "value": 7.3    },
          { "state": "Tasmania",          "category": "Vegetables",  "value": 629.9  },
          { "state": "Tasmania",          "category": "Fruit",       "value": 299.6  },
          { "state": "Tasmania",          "category": "Wine grapes", "value": 61.0   },
          { "state": "Tasmania",          "category": "Nursery",     "value": 24.0   },
          { "state": "Tasmania",          "category": "Nuts",        "value": 10.1   },
          { "state": "Northern Territory","category": "Fruit",       "value": 180.8  },
          { "state": "Northern Territory","category": "Nursery",     "value": 34.4   },
          { "state": "Northern Territory","category": "Vegetables",  "value": 6.6    }
        ]
      },
      "transform": [
        { "filter": { "param": "state_select" } }
      ],
      "mark": { "type": "bar", "cornerRadiusEnd": 3 },
      "encoding": {
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": "-x",
          "axis": { "title": null, "labelFontSize": 11 }
        },
        "x": {
          "field": "value",
          "type": "quantitative",
          "axis": {
            "title": "Farm gate value ($m)",
            "titleFontSize": 11,
            "grid": true,
            "gridColor": "#eeeeee"
          }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": ["Fruit", "Vegetables", "Nursery", "Nuts", "Wine grapes"],
            "range": ["#d4663a", "#4a8c3f", "#2e7a6a", "#f4a225", "#6b4c8a"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "state",    "title": "State" },
          { "field": "category", "title": "Category" },
          { "field": "value",    "title": "Value ($m)", "format": "," }
        ]
      }
    }
  ],
  "resolve": { "scale": { "color": "independent" } },
  "config": { "view": { "stroke": "transparent" } }
}